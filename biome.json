{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!**/node_modules",
      "!**/coverage",
      "!**/docconfig",
      "!**/docs",
      "!**/pnpm-lock.yaml"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2 },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": { "noArguments": "off", "noBannedTypes": "off" },
      "style": { "useTemplate": "off", "useNodejsImportProtocol": "off" },
      "suspicious": {
        "noEmptyBlockStatements": "off",
        "noRedundantUseStrict": "off",
        "noExplicitAny": "off"
      }
    }
  },
  "javascript": {
    "formatter": { "quoteStyle": "single" },
    "globals": ["arguments"]
  },
  "assist": {
    "enabled": true,
    "actions": { "source": { "organizeImports": "on" } }
  },
  "overrides": [
    {
      "includes": ["test/**"],
      "javascript": {
        "globals": [
          "describe",
          "it",
          "before",
          "after",
          "beforeEach",
          "afterEach"
        ]
      },
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": {
              "level": "error",
              "options": { "allow": ["info", "warn"] }
            }
          }
        }
      }
    }
  ]
}

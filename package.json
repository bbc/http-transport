{
  "name": "@bbc/http-transport",
  "version": "5.0.0",
  "description": "A flexible, modular REST client built for ease-of-use and resilience.",
  "main": "index.js",
  "types": "index.d.ts",
  "scripts": {
    "test": "mocha && pnpm run lint",
    "jsdoc": "jsdoc -c ./docconfig/jsdoc.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "coverage": "nyc mocha && nyc report --reporter=html && nyc report --reporter=json-summary"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bbc/http-transport.git"
  },
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/bbc/http-transport/issues"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10"
  },
  "keywords": [
    "https",
    "rest client",
    "http-transport",
    "cache",
    "circuit",
    "breaker",
    "rest",
    "http",
    "json",
    "client"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "chai": "^3.5.0",
    "jsdoc": "^3.5.5",
    "mocha": "^7.2.0",
    "nock": "^11.9.1",
    "nyc": "^15.1.0",
    "sinon": "^1.15.3"
  },
  "dependencies": {
    "@types/node-fetch": "^2.6.11",
    "http-proxy-agent": "^7.0.0",
    "koa-compose": "^4.0.0",
    "node-fetch": "^2.7.0",
    "qs": "^6.5.1"
  },
  "mocha": {
    "recursive": true,
    "exit": true
  }
}
